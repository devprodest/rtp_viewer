#include <winver.h>
#include "util/version.h"

// Собираем строку версии из числовых макросов
#define STRINGIZE2(x) #x
#define STRINGIZE(x) STRINGIZE2(x)
#define VERSION_STR_RAW STRINGIZE(RTP_VIEWER_VERSION_MAJOR) "." STRINGIZE(RTP_VIEWER_VERSION_MINOR) "." STRINGIZE(RTP_VIEWER_VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RTP_VIEWER_VERSION_MAJOR,RTP_VIEWER_VERSION_MINOR,RTP_VIEWER_VERSION_PATCH,0
 PRODUCTVERSION RTP_VIEWER_VERSION_MAJOR,RTP_VIEWER_VERSION_MINOR,RTP_VIEWER_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", RTP_VIEWER_COMPANY_NAME
            VALUE "FileDescription", RTP_VIEWER_PRODUCT_NAME
            VALUE "FileVersion", VERSION_STR_RAW
            VALUE "InternalName", "rtp_viewer.exe"
            VALUE "LegalCopyright", RTP_VIEWER_COPYRIGHT
            VALUE "OriginalFilename", "rtp_viewer.exe"
            VALUE "ProductName", RTP_VIEWER_PRODUCT_NAME
            VALUE "ProductVersion", VERSION_STR_RAW
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END